# ==============================================================================
# Crop Health AI — Backend Environment Template (Local / Staging)
# ==============================================================================

# Server Network Configuration
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Mode Configuration
# Set DEMO_MODE=true for local offline simulation using deterministic synthetic bands.
# Set DEMO_MODE=false to enforce strict live Copernicus Data Space Ecosystem API calls.
DEMO_MODE=true

# Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub Credentials
# Register at https://dataspace.copernicus.eu/ to obtain OAuth2 credentials
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Official Endpoints
COPERNICUS_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_SH_BASE_URL=https://sh.dataspace.copernicus.eu
COPERNICUS_PROCESS_ENDPOINT=/api/v1/process

# Operational Parameters
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=86400

# Optional AI Field Intelligence Provider
# Supported providers: groq (recommended, free at https://console.groq.com/keys), gemini, openai, mock
AI_PROVIDER=mock
GROQ_API_KEY=
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
